{% extends "base.twig" %}

{% set meta = { 'title': 'Sign up – ' ~ site.title, 'robots': 'noindex, follow' } %}

{% block main %}

<section>

  <div class="row">

    <h1>Let's get started</h1>
    <p>Create an account below</p>

  </div>
{% if site.register == false %}
  <div class="row">

    <div class="toast">
      <div><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentcolor"><path d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm0-80h480v-400H240v400Zm296.5-143.5Q560-327 560-360t-23.5-56.5Q513-440 480-440t-56.5 23.5Q400-393 400-360t23.5 56.5Q447-280 480-280t56.5-23.5ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80ZM240-160v-400 400Z"/></svg></div>
      <div class="toast-content">
        <p>New account registrations are paused right now.</p>
      </div>
    </div>

  </div>
{% else %}
{% if toast %}
  <div class="row">

    <div class="toast toast-{{ toast.type }}">
      {{ toast.icon|raw }}
      <div class="toast-content">
{% if toast.heading %}
        <p><strong>{{ toast.heading }}</strong></p>
{% endif %}
        <p>{{ toast.message|raw }}</p>
      </div>
    </div>

  </div>
{% endif %}
{% endif %}
  <form action="/register/" method="post" class="row">

    <div class="form-group{% if form.error.user_email %} has-error{% endif %}">
      <label class="form-label" for="user_email">What's your email address?</label>
      <input class="form-input" type="email" name="user_email" id="user_email" placeholder="Email address" value="{{ form.value.user_email }}"{% if site.register == false %} disabled{% endif %}>
{% if form.error.user_email %}
      <p class="form-input-hint">{{ form.error.user_email.0|raw }}</p>
{% endif %}
    </div>

    <div class="form-group{% if form.error.user_password %} has-error{% endif %}">
      <label class="form-label" for="user_password">Choose a password</label>
      <input class="form-input" type="password" name="user_password" id="user_password" placeholder="Password"{% if site.register == false %} disabled{% endif %}>
{% if form.error.user_password %}
      <p class="form-input-hint">{{ form.error.user_password.0|raw }}</p>
{% else %}
      <p class="form-input-hint">Must be at least 6 characters</p>
{% endif %}
    </div>

    <div class="form-group markdown">
      <p>By clicking on the 'Sign up' button below, you are agreeing to the <a href="/help/terms-and-conditions/" target="_blank">Terms and Conditions</a> and <a href="/help/privacy-policy/" target="_blank">Privacy Policy</a>.</p>
    </div>

    <div class="form-group">
      <button class="btn"{% if site.register == false %} disabled{% endif %}>Sign up to {{ site.title }} &rarr;</button>
    </div>

  </form>
  <div class="row">

    <ul class="user-actions">
      <li><a href="/login/">Log in to your account</a></li>
      <li><a href="/">&larr; Back to {{ site.title }}</a></li>
    </ul>

  </div>

</section>

{% endblock %}
