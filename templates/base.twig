<!doctype html>
  <html lang="en-NZ">
    <head>

      <meta charset="utf-8">

      <title>{{ meta.title }}</title>

      <meta name="viewport" content="width=device-width, initial-scale=1">
      <meta name="description" content="{{ meta.description }}">
      <meta name="robots" content="{{ meta.robots }}" />

      <style type="text/css">

        :root {
          --border-color: rgb(217, 217, 217);
        }

        *, *::before, *::after {
          box-sizing: border-box;
        }

        *:not(dialog) {
          margin: 0;
        }

        /* Body */

        body {
          background-color: rgb(225, 225, 225);
        }

        /* Wrap */

        #wrap {
          margin: 0px auto;
          max-width: 860px;
        }

        /* Header */

        header {
          background-color: rgb(255, 255, 255);
          border-bottom: 1px solid var(--border-color);
        }

        header .row {
          padding: 20px;
        }

        header .flex {
          align-items: center;
          display: flex;
        }

        header .flex-gap {
          flex-grow: 1;
        }

        header .logo {
          height: 14px;
        }

        /* Main */

        main {
          background-color: rgb(255, 255, 255);
        }

        main section {
          padding: 20px;
        }

        /* Footer */

        footer {
          background-color: rgb(242, 242, 242);
        }

        footer .row {
          padding: 20px;
        }

        @media screen and (min-width: 769px) {

          .toggle-button {
            display: none;
          }

          /* Header */

          header .row {
            padding: 20px 40px;
          }

          /* Main */

          main section {
            padding: 40px;
          }

          /* Footer */

          footer .row {
            padding: 20px 40px;
          }

        }

      </style>

      <link rel="preload" href="/asset/css/style.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
      <noscript><link rel="stylesheet" href="/asset/css/style.css"></noscript>

    </head>
    <body>

      <div id="menu">

      </div>
      <div id="panel">

        <div id="wrap">

          <header>

            <div class="row">
              <div class="flex">

                <button class="toggle-button">☰</button>

                <div class="flex-gap"></div>

{% if user %}
                <ul class="dropdown-user">
                    <li>
                      <a class="dropdown-toggle"><span class="user">Setting &amp; Account</span></a>

                      <div class="dropdown">
                        <ul>
{% if user_role <= 2 %}
                          <li><a href="/admin/">Admin</a></li>
{% endif %}
                          <li><a href="/account/">Account</a></li>
                        </ul>
                        <ul>
                          <li><a href="/logout/">Log out</a></li>
                        </ul>
                      </div>
                    </li>
                  </ul>
{% else %}
                  <ul class="dropdown-user mobile-only">
                    <li>
                      <a class="dropdown-toggle"><span class="user">Setting &amp; Account</span></a>
                      <div class="dropdown">
                        <ul>
                          <li><a href="/login/">Log in</a></li>
                        </ul>
                      </div>
                    </li>
                  </ul>

                  <nav class="nav-user">
                    <a href="/login/">Log in</a>
                  </nav>
{% endif %}

              </div>
            </div>

          </header>
          <main>
{% block main %}{% endblock %}
          </main>
          <footer>

            <section>

              <div class="row">
                <div class="grid">

                  <div class="footer-about">

                    <h3>About Us</h3>
                    <p>Sandwichboard (sandwichboard.co.nz) helps people find good places to eat in Auckland, built by the community. The name comes from those handwritten sandwich boards you see outside cafes. This is that same idea, just passed along from one local to another.</p>

                  </div>
                  <div class="footer-links">

                    <div class="footer-links_section">

                      <h4>Learn More</h4>

                      <ul>
                        <li><a href="/about/">About Us</a></li>
                        <li><a href="/help/">FAQ</a></li>
                      </ul>

                    </div>
                    <div class="footer-links_section">

                      <h4>Suburbs</h4>

                      <ul>
                        <li>Coming Soon</li>
                      </ul>

                    </div>

                  </div>

                </div>
              </div>

            </section>
            <section>

              <div class="row">
                <div class="footer-copyright">

                  <ul>
                    <li>&copy; {{ now|date('Y') }} {{ site.title }}. All rights reserved.</li>
                    <li><a href="/help/terms-and-conditions/">Terms and Conditions</a></li>
                    <li><a href="/help/privacy-policy/">Privacy Policy</a></li>
                    <li><a href="/help/cookie-policy/">Cookie Policy</a></li>
                  </ul>

                </div>
              </div>

            </section>

          </footer>

        </div>

      </div>

      <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/slideout/1.0.1/slideout.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.2/jquery.modal.min.js"></script>
      <script src="/asset/js/script.js"></script>

    </body>
  </html>
