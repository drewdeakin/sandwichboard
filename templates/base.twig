<!doctype html>
  <html lang="en-NZ">
    <head>

      <meta charset="utf-8">

      <title>{{ meta.title }}</title>

      <meta name="viewport" content="width=device-width, initial-scale=1">
      <meta name="description" content="{{ meta.description }}">
      <meta name="robots" content="{{ meta.robots }}" />

      <link rel="stylesheet" href="/asset/css/style.css">

    </head>
    <body>

      <div id="menu">

      </div>
      <div id="panel">

        <div id="wrap">

          <header>

            <div class="row">
              <div class="flex">

                <button class="toggle-button">☰</button>

              </div>
            </div>

          </header>
          <main>
{% block main %}{% endblock %}
          </main>
          <footer>

            <section>

              <div class="row">
                <div class="grid">

                  <div class="footer-about">

                    <h3>About Us</h3>
                    <p>Sandwichboard (sandwichboard.co.nz) helps people find good places to eat in Auckland, built by the community. The name comes from those handwritten sandwich boards you see outside cafes. This is that same idea, just passed along from one local to another.</p>

                  </div>
                  <div class="footer-links">

                    <div class="footer-links_section">

                      <h4>Learn More</h4>

                      <ul>
                        <li><a href="/about/">About Us</a></li>
                        <li><a href="/help/">FAQ</a></li>
                      </ul>

                    </div>
                    <div class="footer-links_section">

                      <h4>Suburbs</h4>

                      <ul>
                        <li>Coming Soon</li>
                      </ul>

                    </div>

                  </div>

                </div>
              </div>

            </section>
            <section>

              <div class="row">
                <div class="footer-copyright">

                  <ul>
                    <li>&copy; {{ now|date('Y') }} {{ site.title }}. All rights reserved.</li>
                    <li><a href="/help/terms-and-conditions/">Terms and Conditions</a></li>
                    <li><a href="/help/privacy-policy/">Privacy Policy</a></li>
                    <li><a href="/help/cookie-policy/">Cookie Policy</a></li>
                  </ul>

                </div>
              </div>

            </section>

          </footer>

        </div>

      </div>

      <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/slideout/1.0.1/slideout.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.2/jquery.modal.min.js"></script>
      <script src="/asset/js/script.js"></script>

    </body>
  </html>
